[Unit]
Description=Zog host-deploy GitHub execution gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/host-deploy/gateway.env
ExecStart=/usr/bin/host-deploy-gateway --state-directory /var/lib/host-deploy-gateway run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
StateDirectory=host-deploy-gateway
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/host-deploy-gateway

[Install]
WantedBy=multi-user.target
