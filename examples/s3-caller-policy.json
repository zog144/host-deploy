{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DevelopmentTransferBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:GetBucketTagging", "s3:PutBucketTagging",
        "s3:PutBucketPublicAccessBlock", "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration", "s3:ListBucket", "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_APPROVED_TRANSFER_BUCKET_PREFIX-*"
    },
    {
      "Sid": "DevelopmentTransferObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_APPROVED_TRANSFER_BUCKET_PREFIX-*/*"
    }
  ]
}
