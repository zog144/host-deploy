# SOURCE TEMPLATE ONLY; do not start until native authority is admitted.
[Unit]
Description=Protected Zog graphical read-only original trust/history broker
Requires=zog-graphical-trust.socket
After=network-online.target

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/python3 -I -m zog.host_deploy.gateway.graphics_owner_trust_daemon
Sockets=zog-graphical-trust.socket
RequiresMountsFor=/var/lib/zog-graphical-owner-ledger
LoadCredential=read-only-checkpoint.json:/var/lib/zog-graphical-trust-credential-source/read-only-checkpoint.json
LoadCredential=broker-private.key:/etc/zog/graphical-owner/trust-broker-private.key
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
UMask=0077
ReadOnlyPaths=/etc/zog/graphical-owner
ReadOnlyPaths=/var/lib/zog-graphical-owner-ledger
ReadWritePaths=/run/zog
# Credentials are explicit protected installation inputs, absent until native
# admission. The read-only role must be proven GetObject-only for the exact
# retained original checkpoint; never reuse owner SSM or checkpoint PUT roles.
# Installation does not enable or start this unit.
