# SOURCE TEMPLATE ONLY; host-install must attest exact bytes and keep inactive.
[Unit]
Description=Protected Zog graphical original trust/history broker socket

[Socket]
ListenStream=/run/zog/graphical-owner-trust.sock
SocketUser=root
SocketGroup=zog-graphical-client
SocketMode=0660
DirectoryMode=0755
Accept=no
Service=zog-graphical-trust.service
FileDescriptorName=trust-history
RemoveOnStop=yes

# No [Install] stanza: never enable as a dependency of installing files.
